# ===================================================================
# REO Dashboard - Multi-Environment Configuration
# ===================================================================
#
# This dashboard now supports multiple environments (mainnet, testnet, testnet_new).
# Contract addresses are automatically fetched from:
# https://raw.githubusercontent.com/graphprotocol/contracts/refs/heads/main/packages/issuance/addresses.json
#
# ENVIRONMENT CONFIGURATION:
# --------------------------
# The dashboard fetches contract addresses dynamically for each network:
# - mainnet (Arbitrum One): Network ID 42161
# - testnet (Arbitrum Sepolia): Network ID 421614
# - testnet_new (Arbitrum Sepolia - Alternative deployment): Only if configured below
#
# Manual Configuration (Optional):
# -----------------------------------
# If GitHub JSON doesn't have an address, or you want to add a test environment:
# MAINNET_CONTRACT_ADDRESS=0x...  # Mainnet contract address (if deployed)
# TESTNET_NEW_CONTRACT_ADDRESS=0x...  # Alternative testnet deployment for testing
# TESTNET_NEW_DEPLOYMENT_BLOCK=123456  # Deployment block for alternative testnet

# ===================================================================
# FALLBACK CONFIGURATION (Optional)
# ===================================================================
# Only needed if GitHub JSON registry is unavailable
# CONTRACT_ADDRESS=0x9BED32d2b562043a426376b99d289fE821f5b04E

# ===================================================================
# RPC ENDPOINTS
# ===================================================================
# Each network requires its own RPC endpoint since mainnet (Arbitrum One)
# and testnet (Arbitrum Sepolia) are different chains.
#
# Network-specific endpoints are checked first. If none are set for a
# given network, the generic RPC_ENDPOINT is used as a fallback.

# Arbitrum One (mainnet) - required for mainnet environment
RPC_ENDPOINT_MAINNET=https://arb1.arbitrum.io/rpc

# Arbitrum Sepolia (testnet) - required for testnet environment
RPC_ENDPOINT_TESTNET=https://sepolia-rollup.arbitrum.io/rpc

# Additional endpoints per network for failover (optional)
# RPC_ENDPOINT_MAINNET_2=https://arbitrum-one.public.blastapi.io
# RPC_ENDPOINT_TESTNET_2=https://rpc.ankr.com/arbitrum_sepolia

# Generic fallback (used only if no network-specific endpoint is set)
# RPC_ENDPOINT=https://arbitrum.llamarpc.com

# ===================================================================
# API KEYS
# ===================================================================
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# Graph API Key for subgraph queries
GRAPH_API_KEY=your_graph_api_key_here

# ===================================================================
# ENS CACHE CONFIGURATION
# ===================================================================
# If set to "Y", use cached ENS data from ens_resolution.json
# If set to "N", fetch ENS names from the ENS subgraph
USE_CACHED_ENS=N

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
# SQLite database file path (default: reo.db)
# REO_DB_PATH=reo.db

# ===================================================================
# TELEGRAM BOT CONFIGURATION (Optional)
# ===================================================================
# To enable Telegram notifications:
# 1. Create a bot via @BotFather on Telegram
# 2. Get your bot token
# 3. Add it below (uncomment the line)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Dashboard URL (for Telegram notification links)
DASHBOARD_URL=https://dashboards.thegraph.foundation/reo/
