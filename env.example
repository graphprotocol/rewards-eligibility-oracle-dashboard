# ===================================================================
# REO Dashboard - Multi-Environment Configuration
# ===================================================================
#
# This dashboard supports two environments: mainnet (Arbitrum One) and
# testnet (Arbitrum Sepolia). Contract addresses are automatically fetched from:
# https://raw.githubusercontent.com/graphprotocol/contracts/refs/heads/main/packages/issuance/addresses.json
#
# ENVIRONMENT CONFIGURATION:
# --------------------------
# The dashboard fetches contract addresses dynamically for each network:
# - mainnet (Arbitrum One): Network ID 42161
# - testnet (Arbitrum Sepolia): Network ID 421614
#
# Manual Configuration (Optional):
# -----------------------------------
# Override a registry-resolved address, or supply one the registry lacks:
# MAINNET_CONTRACT_ADDRESS=0x...  # Pin the mainnet (Arbitrum One) oracle
# TESTNET_CONTRACT_ADDRESS=0x...  # Pin the testnet oracle. The Sepolia registry has
#                                 # several variants (RewardsEligibilityOracleA/B/Mock);
#                                 # the auto-pick lands on A. Set this to choose another.

# ===================================================================
# FALLBACK CONFIGURATION (Optional)
# ===================================================================
# Only needed if GitHub JSON registry is unavailable
# CONTRACT_ADDRESS=0x9BED32d2b562043a426376b99d289fE821f5b04E

# ===================================================================
# RPC ENDPOINTS
# ===================================================================
# Each network requires its own RPC endpoint since mainnet (Arbitrum One)
# and testnet (Arbitrum Sepolia) are different chains.
#
# Network-specific endpoints are checked first. If none are set for a
# given network, the generic RPC_ENDPOINT is used as a fallback.

# Arbitrum One (mainnet) - required for mainnet environment
RPC_ENDPOINT_MAINNET=https://arb1.arbitrum.io/rpc

# Arbitrum Sepolia (testnet) - required for testnet environment
RPC_ENDPOINT_TESTNET=https://sepolia-rollup.arbitrum.io/rpc

# Additional endpoints per network for failover (optional)
# RPC_ENDPOINT_MAINNET_2=https://arbitrum-one.public.blastapi.io
# RPC_ENDPOINT_TESTNET_2=https://rpc.ankr.com/arbitrum_sepolia

# Generic fallback (used only if no network-specific endpoint is set)
# RPC_ENDPOINT=https://arbitrum.llamarpc.com

# ===================================================================
# API KEYS
# ===================================================================
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# Graph API Key for subgraph queries
GRAPH_API_KEY=your_graph_api_key_here

# ===================================================================
# ENS CACHE CONFIGURATION
# ===================================================================
# If set to "N", fetch ENS names fresh from the ENS subgraph (recommended).
# If set to "Y", reuse the cached names from the SQLite ens_cache table. Note:
# in "Y" mode the cache is used as-is and is NOT topped up from the subgraph
# unless it is completely empty, so newly added indexers stay unnamed until an
# "N" run refreshes the cache.
USE_CACHED_ENS=N

# ===================================================================
# DATABASE / OUTPUT CONFIGURATION
# ===================================================================
# SQLite database file path (default: reo.db)
# REO_DB_PATH=reo.db
# Directory the generated index.html is written to (default: output)
# REO_OUTPUT_DIR=output

# ===================================================================
# VERCEL DEPLOYMENT (not needed for local runs or Docker)
# ===================================================================
# Both are set automatically in the Vercel project — listed here so the
# deployment's full configuration is documented in one place.
#
# Created by connecting a Blob store to the project. Its presence is what
# switches storage.py from "no-op" to "round-trip state through Blob", so
# leaving it unset locally is what keeps local runs behaving as they always did.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
#
# Any random string of 16+ characters. Vercel sends it as a bearer token on cron
# invocations; api/refresh.py rejects anything else. Without it the refresh
# endpoint denies every request, including the cron's — set it before deploying.
# CRON_SECRET=
